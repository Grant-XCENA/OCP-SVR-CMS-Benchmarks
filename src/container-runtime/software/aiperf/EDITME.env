# =============================================================================
# AIPerf + LMCache — Two-Container OCP CMS Benchmark
# =============================================================================
#
#   Container 1: lmcache-server-gpu  — vLLM + LMCache serving engine (GPU)
#   Container 2: aiperf-client       — AIPerf load generator + CMS reporting
#
# Usage:
#   cp EDITME.env .env && nano .env
#   docker compose build && docker compose up
#
# =============================================================================

HOST_RESULTS_DIR=./results

# #############################################################################
# AUTHENTICATION
# #############################################################################
HF_TOKEN=

# #############################################################################
# MODEL
# #############################################################################
AIPERF_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_MAX_MODEL_LEN=4096

# #############################################################################
# GPU TUNING
# #############################################################################
CUDA_VISIBLE_DEVICES=0
VLLM_GPU_MEMORY_UTILIZATION=0.8

# #############################################################################
# LMCACHE BACKEND — change this one line to swap backends
# #############################################################################
#   none          Plain vLLM, no LMCache (baseline comparison)
#   cpu_offload   LMCache CPU RAM offloading (default, no extra services)
#   disk          LMCache local disk offloading (no extra services)
#   redis         LMCache + Redis (set LMCACHE_REMOTE_HOST/PORT)
#   lmserver      LMCache + LMCache server (lm:// protocol)
#   mooncake      LMCache + Mooncake distributed store
#   infinistore   LMCache + InfiniStore (RDMA)
#   maru          LMCache + Maru CXL shared memory (requires maru-server + /dev/dax*)
#   custom        Your own config (set LMCACHE_CONFIG_FILE_CONTENT)
LMCACHE_BACKEND=cpu_offload

# -- Remote backend connection --
#LMCACHE_REMOTE_HOST=localhost
#LMCACHE_REMOTE_PORT=6379

# -- Maru CXL backend --
#LMCACHE_MARU_HOST=localhost
#LMCACHE_MARU_PORT=5555
#LMCACHE_MARU_POOL_SIZE=4

# -- Maru container tuning --
#MARU_GIT_REF=main
#MARU_RM_HOST=127.0.0.1
#MARU_RM_PORT=9850
#MARU_SERVER_HOST=0.0.0.0
#MARU_LOG_LEVEL=INFO

# -- Mooncake --
#LMCACHE_MOONCAKE_METADATA_SERVER=http://localhost:8080/metadata
#LMCACHE_MOONCAKE_PROTOCOL=tcp

# -- InfiniStore --
#LMCACHE_INFINISTORE_DEVICE=mlx5_1

# -- Custom config --
#LMCACHE_CONFIG_FILE_CONTENT=

# #############################################################################
# DEPLOYMENT MODE
# #############################################################################
# For split-machine deployment, set the server URL on the client machine:
#AIPERF_SERVER_URL=http://192.168.1.100:30080

# #############################################################################
# AIPERF BENCHMARK CONFIGURATION
# #############################################################################
AIPERF_SUITE_NAME=ocp-cms-aiperf

# -- Endpoint --
AIPERF_ENDPOINT_TYPE=chat
AIPERF_STREAMING=true

# -- Load pattern (concurrency mode — set AIPERF_REQUEST_RATE for rate mode) --
AIPERF_CONCURRENCY=10
AIPERF_REQUEST_COUNT=100
#AIPERF_REQUEST_RATE=32

# -- Sequence lengths (synthetic workload) --
#AIPERF_ISL=1024
#AIPERF_OSL=512

# -- Warmup --
AIPERF_WARMUP_REQUEST_COUNT=5

# -- Tokenizer (auto-detected from model if not set) --
#AIPERF_TOKENIZER=

# -- Multi-run confidence (run N times, report statistics) --
AIPERF_NUM_PROFILE_RUNS=1

# -- Public datasets --
# Uncomment ONE of these for dataset-driven benchmarking:
#AIPERF_PUBLIC_DATASET=sharegpt

# -- Custom input files --
# Mount your trace file and set the path:
#AIPERF_INPUT_FILE=/data/traces/my_trace.jsonl
#AIPERF_CUSTOM_DATASET_TYPE=mooncake_trace
#AIPERF_FIXED_SCHEDULE=false

# -- Goodput SLOs (in ms) --
#AIPERF_GOODPUT_TTFT=370
#AIPERF_GOODPUT_LATENCY=648

# -- Extra CLI args (passed directly to aiperf profile) --
#AIPERF_EXTRA_ARGS=

# #############################################################################
# KV CACHE PARAMETER SWEEP (optional)
# #############################################################################
# Enable multi-level sweep to systematically vary KV cache hit rates.
# When enabled, the single-run benchmark above is SKIPPED — the sweep
# replaces it with one aiperf invocation per sweep level.
#
# Set AIPERF_SWEEP_ENABLED=true to activate.
#AIPERF_SWEEP_ENABLED=false

# -- Sweep levels to run (comma-separated target cache-hit percentages) --
# Default runs all 10 levels: 95,90,85,80,75,50,25,15,10,5
# Customize to run a subset, e.g. "95,50,5" for quick 3-point sweep.
#AIPERF_SWEEP_LEVELS=95,90,85,80,75,50,25,15,10,5

# -- Per-level overrides --
# Each parameter is a comma-separated list aligned with AIPERF_SWEEP_LEVELS.
# If fewer values are given than levels, the LAST value is repeated.
# If left unset, built-in defaults are used (tuned for Qwen/Qwen3-0.6B).
#
# Example: 3 levels "95,50,5" with custom concurrency:
#   AIPERF_SWEEP_LEVELS=95,50,5
#   AIPERF_SWEEP_CONCURRENCY=3,25,100
#
#AIPERF_SWEEP_TURN_MEAN=15,12,10,8,6,4,2,2,1,1
#AIPERF_SWEEP_TURN_STDDEV=2,2,3,2,2,1,1,0,0,0
#AIPERF_SWEEP_TURN_DELAY_MS=200,500,1000,2000,3000,5000,10000,15000,20000,0
#AIPERF_SWEEP_ISL=50,100,150,200,300,500,800,1000,1200,1500
#AIPERF_SWEEP_OSL=100,120,150,150,150,150,150,200,200,200
#AIPERF_SWEEP_CONCURRENCY=3,5,8,12,15,25,40,60,80,100
#AIPERF_SWEEP_SHARED_PROMPT=2000,1500,1000,800,500,200,100,0,0,0
#AIPERF_SWEEP_CONV_NUM=30,30,40,40,50,60,80,100,120,200
#AIPERF_SWEEP_DATASET_ENTRIES=100,150,200,250,300,400,500,600,700,1000

# -- Sweep timing --
#AIPERF_SWEEP_COOLDOWN=30                 # Seconds between sweep levels
#AIPERF_SWEEP_DURATION=120                # Per-level benchmark duration (seconds)
#AIPERF_SWEEP_METRICS_INTERVAL=5          # Prometheus scrape interval (seconds)

# -- Skip / filter --
# Comma-separated list of hit% levels to skip (e.g. "75,50" skips those two).
# Useful for re-running a subset after tuning without repeating all levels.
#AIPERF_SWEEP_SKIP_LEVELS=

# -- Dry run --
# When true, logs every aiperf command that WOULD run but does not execute.
# Useful for regression testing, CI log collection, and validating .env config.
#AIPERF_SWEEP_DRY_RUN=false

# -- Prometheus metrics endpoint (for actual cache hit rate + GPU util) --
# Defaults to the vLLM server's /metrics endpoint.
#AIPERF_SWEEP_METRICS_URL=http://localhost:30080/metrics

# -- GPU utilization floor --
# Sweep will log warnings if GPU util falls below this threshold.
#AIPERF_SWEEP_GPU_UTIL_FLOOR=75

# -- Connection strategy for multi-turn sweeps --
#AIPERF_SWEEP_CONNECTION_STRATEGY=sticky-user-sessions

# -- Hybrid: native AIPerf confidence aggregation (targeted mode) --
# When >1, each cache-hit level runs N profile runs and AIPerf produces its
# own aggregate/ dir with mean/std/confidence intervals for that level.
# parameter-sweep-mode: 'repeated' (default) or 'independent'.
#AIPERF_SWEEP_NUM_PROFILE_RUNS=1
#AIPERF_SWEEP_PARAM_SWEEP_MODE=repeated

# -- Hybrid: native passthrough sweep (NO cache-hit targeting) --
# For a pure single-axis parameter sweep handled entirely by native AIPerf
# (its own sweep_aggregate/ with best-config + Pareto analysis). Provide the
# sweep axis via AIPERF_EXTRA_ARGS. This BYPASSES cache-hit targeting,
# cache reset, and Prometheus verification — use only when you want a plain
# parameter sweep, not a controlled KV-cache-hit-rate sweep.
#   AIPERF_SWEEP_NATIVE_PASSTHROUGH=true
#   AIPERF_EXTRA_ARGS=--concurrency 10,20,50,100
#AIPERF_SWEEP_NATIVE_PASSTHROUGH=false

# #############################################################################
# ADVANCED
# #############################################################################
#AIPERF_VERSION=main
#EXTRA_PIP_PACKAGES=
#CMS_VERBOSITY=0
